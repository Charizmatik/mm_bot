# Portainer stack environment for http://192.168.1.108/
APP_ENV=production
DRY_RUN=true

# Replace both password placeholders with the same long random password.
# URL-encode special characters in DATABASE_URL.
POSTGRES_DB=market_maker
POSTGRES_USER=market_maker
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+asyncpg://market_maker:CHANGE_ME_URL_ENCODED_PASSWORD@postgres:5432/market_maker

MEXC_API_KEY=
MEXC_API_SECRET=
CORS_ORIGINS=http://192.168.1.108
ENGINE_TICK_SECONDS=1
QUOTE_STALE_SECONDS=10
BALANCE_REFRESH_SECONDS=10
PAPER_MAKER_FEE_PCT=0.1

HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000

# Enable only during a migration window, then redeploy with false.
# Also set COMPOSE_PROFILES=remote-migrations in Portainer for that window.
ALLOW_REMOTE_DB_MIGRATIONS=false
REMOTE_DB_BIND_ADDRESS=192.168.1.108
REMOTE_DB_PORT=15432

# Used only on the developer PC by the remote-migrate service.
REMOTE_DATABASE_URL=postgresql+asyncpg://market_maker:CHANGE_ME_URL_ENCODED_PASSWORD@192.168.1.108:15432/market_maker
