# Keep DRY_RUN=true until the strategy is verified with your account.
APP_ENV=development
DRY_RUN=true
POSTGRES_DB=market_maker
POSTGRES_USER=market_maker
POSTGRES_PASSWORD=market_maker
DATABASE_URL=postgresql+asyncpg://market_maker:market_maker@postgres:5432/market_maker
MEXC_API_KEY=
MEXC_API_SECRET=
MEXC_RECV_WINDOW_MS=10000
MEXC_TIME_SYNC_INTERVAL_SECONDS=300
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ENGINE_TICK_SECONDS=1
QUOTE_STALE_SECONDS=10
BALANCE_REFRESH_SECONDS=10
PAPER_MAKER_FEE_PCT=0.1
ACCOUNT_SNAPSHOT_TIMEZONE=Europe/Kyiv

# HTTP ports. The backend is intentionally bound to localhost.
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=8080
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000

# Keep false unless a short maintenance window is in progress.
ALLOW_REMOTE_DB_MIGRATIONS=false
REMOTE_DB_BIND_ADDRESS=127.0.0.1
REMOTE_DB_PORT=15432
REMOTE_DATABASE_URL=postgresql+asyncpg://market_maker:market_maker@127.0.0.1:15432/market_maker
